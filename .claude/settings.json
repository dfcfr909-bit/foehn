{
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/statusline.mjs\"",
    "padding": 2
  },
  "permissions": {
    "allow": [
      "Bash(node tests/run-all.js)",
      "Bash(node tests/*)",
      "Bash(npm test)",
      "Bash(cd tests && npm test)",
      "Bash(cd tests && npm install)",
      "Bash(node scripts/gen-icons.mjs)",
      "Bash(node --version)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git remote -v)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git for-each-ref*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git tag)",
      "Bash(git tag -l*)",
      "Bash(ls*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(diff*)",
      "Bash(jq*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(wrangler secret*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  }
}
